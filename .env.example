# Session cookie signing
SESSION_SECRET=change-me-long-random-string

# Public HTTPS origin (must match the tunnel domain exactly, no trailing slash)
PUBLIC_ORIGIN=https://aisle-demo.ngrok-free.app
# WebAuthn relying party id = the domain only
RP_ID=aisle-demo.ngrok-free.app
RP_NAME=SpeedMart

# Shared secret the vision worker sends on /internal/* routes
INTERNAL_TOKEN=change-me-too

# Admin panel password
ADMIN_PASSWORD=change-me-three

# Gate tokens embedded in QR B (entry) and QR C (exit) URLs
ENTRY_GATE_TOKEN=entry-7d2f
EXIT_GATE_TOKEN=exit-91ac

# Stripe test mode (F10). Must start with sk_test_
STRIPE_SECRET_KEY=

# LLM (F11). Set one provider.
LLM_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# AI assisted dispute review (F20, 8.14). A vision capable model reviews shelf keyframes when a dispute needs a
# human; a person still decides everything except small refunds the review clearly supports. Empty values reuse
# LLM_PROVIDER and that provider's key, base URL and model (REVIEW_PROVIDER=openai reuses OPENAI_API_KEY and
# OPENAI_BASE_URL). At startup the backend checks that the model accepts an image and logs "review_model_probe";
# if it does not, reviews use the timeline only.
REVIEW_PROVIDER=
REVIEW_MODEL=

# ElevenLabs voice store agent (F19). Server-side only: the key is never sent to the browser.
# Agent id from the ElevenLabs Agents dashboard (agent_...). The agent must have authentication enabled.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Kiosk agent (the entrance tablet). The kiosk is opened as https://<domain>/kiosk.html?k=<KIOSK_TOKEN>; every
# kiosk-only endpoint checks it. Empty = the kiosk stays the public page (QR codes, status, shelf map), with no
# voice and no shopper data. Use a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
KIOSK_TOKEN=
# Voice the kiosk speaks with (ElevenLabs text to speech, uses ELEVENLABS_API_KEY). Voice id from the ElevenLabs
# voice library (Voices -> a voice -> ID). Empty = the kiosk shows its lines as captions only.
ELEVENLABS_VOICE_ID=
